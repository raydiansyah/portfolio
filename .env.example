# Supabase (browser-safe keys only; never put the service-role key here)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Cloudflare Turnstile — required when CAPTCHA protection is enabled in Supabase Auth
VITE_TURNSTILE_ENABLED=on
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
